[0.082374, "o", "\u001b[1mpan-agent demo\u001b[0m: endpoint http://localhost:8000/v1, model primary (auto-detected: first id from GET http://localhost:8000/v1/models; set MODEL to override)\r\nscratch profile: DEMO_HOME=/tmp/pan-demo (used as HERMES_HOME)\r\n"]
[0.127542, "o", "\u001b[2m  wrote $DEMO_HOME/config.yaml (Hermes: model.provider custom, base_url http://localhost:8000/v1)\u001b[0m\r\n\u001b[2m  wrote $DEMO_HOME/pan/config.yaml (PAN's memory gate: the LLM gate on the same endpoint)\u001b[0m\r\n"]
[1.129459, "o", "\r\n\u001b[1m# 0. Check the endpoint: tool calls (for Hermes) and json_schema (for PAN's memory gate)\u001b[0m\r\n"]
[1.129889, "o", "\u001b[32m$\u001b[0m pan doctor --base-url http://localhost:8000/v1 --model primary --no-thinking --skip tool_corruption\r\n"]
[27.147056, "o", "endpoint http://localhost:8000/v1  model primary\r\n\r\nmodels           OK       0.0s  primary listed (1 model(s))\r\ntool_calls       OK      20.5s  6/6 ok, TTFT median 1.59s, total median 2.61s\r\ntool_corruption  SKIP     0.0s  skipped (--skip)\r\njson_schema      OK       5.4s  json_schema output validates\r\n"]
[28.187481, "o", "\r\n\u001b[1m# 1. Install PAN into the scratch profile: pan setup\u001b[0m\r\n"]
[28.188011, "o", "\u001b[32m$\u001b[0m pan setup\r\n"]
[28.601232, "o", "✓ Set memory.provider = pan in $DEMO_HOME/config.yaml\r\n"]
[29.01735, "o", "✓ Set memory.memory_enabled = True in $DEMO_HOME/config.yaml\r\n"]
[29.387407, "o", "✓ Set memory.user_profile_enabled = True in $DEMO_HOME/config.yaml\r\n"]
[29.738693, "o", "✓ Set memory.nudge_interval = 0 in $DEMO_HOME/config.yaml\r\n"]
[29.86275, "o", "settings backup written: $DEMO_HOME/pan/setup-backup.json\r\nrunning: hermes config set memory.provider pan\r\nrunning: hermes config set memory.memory_enabled true\r\nrunning: hermes config set memory.user_profile_enabled true\r\nrunning: hermes config set memory.nudge_interval 0\r\nPAN state directory ready: $DEMO_HOME/pan\r\nwiki initialized: $DEMO_HOME/pan/wiki\r\n"]
[29.863065, "o", "index built: 1 pages -> $DEMO_HOME/pan/index.db\r\nrun the curator with `pan memoryd run` (foreground) or `pan daemon install` (systemd user unit)\r\n"]
[30.899196, "o", "\r\n\u001b[1m# 2. Session 1: tell the agent a fact and a preference\u001b[0m\r\n"]
[30.89929, "o", "\u001b[32m$\u001b[0m hermes chat -q \"For the record: our staging database runs on port 5433, and please always answer me in short bullet points.\" -Q --max-turns 8\r\n"]
[59.404071, "o", "  agent> Done.\r\n  agent> - Noted: staging DB port 5433\r\n  agent> - Noted: short bullet-point answers\r\n  agent> - Both saved to persistent memory for future sessions\r\n"]
[59.40857, "o", "\u001b[2m  session: 20260929_105605_5ec098\u001b[0m\r\n"]
[60.409888, "o", "\r\n\u001b[1m# 3. Curate: pan-memoryd processes the queued turn once and exits\u001b[0m\r\n"]
[60.410768, "o", "\u001b[32m$\u001b[0m pan memoryd run --once\r\n"]
